      name: 'UniFi: descoberta de dispositivos'
      type: DEPENDENT
      key: unifi.device.discovery
      delay: '0'
      lifetime: 7d
      description: Descobre APs (uap), switches (usw) e gateways (ugw) adotados no site {$UNIFI.SITE}.
      filter:
        evaltype: AND
        conditions:
        - macro: '{#TYPE}'
          value: '{$UNIFI.LLD.TYPE.MATCHES}'
          formulaid: A
        - macro: '{#NAME}'
          value: '{$UNIFI.LLD.NAME.NOT_MATCHES}'
          operator: NOT_MATCHES_REGEX
          formulaid: B
      item_prototypes:
