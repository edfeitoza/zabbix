          parameters:
          - $.devices[?(@.mac=='{#MAC}')].state.first()
        master_item: *id002
        tags:
        - tag: component
          value: device
        - tag: device
          value: '{#NAME}'
        trigger_prototypes:
        - uuid: 08b2bc0fd3a440069bd34ec701adb4d8
          expression: count(/UniFi Controller Legacy by Script/unifi.device.state[{#MAC}],{$UNIFI.OFFLINE.PERIOD},"eq","1")=0 and count(/UniFi Controller Legacy by Script/unifi.device.state[{#MAC}],{$UNIFI.OFFLINE.PERIOD})>0
          name: 'UniFi: {#NAME} ({#MODEL}) não conectado à controladora'
          priority: HIGH
          recovery_mode: RECOVERY_EXPRESSION
          recovery_expression: last(/UniFi Controller Legacy by Script/unifi.device.state[{#MAC}])=1
          description: 'Nenhuma leitura com estado "Conectado" em {$UNIFI.OFFLINE.PERIOD}. IP: {#IP}, MAC: {#MAC}.'
          dependencies: *id004
          tags:
          - tag: scope
            value: availability
      - uuid: 21d0e724f6934ecbac169f7fc4a095f7
        name: '{#NAME}: uptime'
        type: DEPENDENT
        key: unifi.device.uptime[{#MAC}]
        delay: '0'
        history: 30d
        value_type: UNSIGNED
        units: uptime
        preprocessing:
        - type: JSONPATH
          parameters:
          - $.devices[?(@.mac=='{#MAC}')].uptime.first()
          error_handler: DISCARD_VALUE
        master_item: *id002
        tags:
