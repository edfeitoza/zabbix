          error_handler: DISCARD_VALUE
        master_item: *id002
        tags:
        - tag: component
          value: clients
        - tag: device
          value: '{#NAME}'
      - uuid: 88bee373ed7e439bafb43ad3ce5d6b72
        name: '{#NAME}: CPU'
        type: DEPENDENT
        key: unifi.device.cpu[{#MAC}]
        delay: '0'
        history: 30d
        value_type: FLOAT
        units: '%'
        preprocessing:
