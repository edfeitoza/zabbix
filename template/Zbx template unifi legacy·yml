          name: 'UniFi: {#NAME} foi reiniciado'
          priority: WARNING
          manual_close: 'YES'
          dependencies: *id004
          tags:
          - tag: scope
            value: notice
      - uuid: c393ea29e149423d84936b74296ed058
        name: '{#NAME}: clientes'
        type: DEPENDENT
        key: unifi.device.clients[{#MAC}]
        delay: '0'
        history: 30d
        value_type: UNSIGNED
        preprocessing:
