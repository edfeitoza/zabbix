  version: '7.0'
  template_groups:
  - uuid: 44244a9102834e99b1f211f477f17c9e
    name: Templates/Network devices
  templates:
  - uuid: ef2a805a7cd4402d9fb331da8b240b20
    template: UniFi Controller Legacy by Script
    name: UniFi Controller Legacy by Script
    description: 'Monitora a UniFi Network Application legada (porta 8443) via API com login por cookie.

      Um host por site. Configure {$UNIFI.URL}, {$UNIFI.USER}, {$UNIFI.PASSWORD} e {$UNIFI.SITE}.'
    groups:
    - name: Templates/Network devices
    items:
    - uuid: 47c73115738445deacfebf135dad94af
      name: 'UniFi: coleta da API (master)'
      type: SCRIPT
      key: unifi.api.get
      delay: '{$UNIFI.INTERVAL}'
      history: '0'
      value_type: TEXT
      trends: '0'
      params: |
        var params = JSON.parse(value);
        var base = String(params.url || '').replace(/\/+$/, '');
        var site = params.site || 'default';
        if (!base) throw 'Macro {$UNIFI.URL} vazia';

        function num(v) {
            if (v === undefined || v === null || v === '') return undefined;
            var n = parseFloat(v);
            return isNaN(n) ? undefined : n;
        }

        function getSession(req) {
            var headers = req.getHeaders(true);
            var list = [], csrf = '';
            for (var name in headers) {
                if (name.toLowerCase() !== 'set-cookie') continue;
                var values = headers[name];
                if (!Array.isArray(values)) values = [values];
                for (var i = 0; i < values.length; i++) {
                    var pair = String(values[i]).split(';')[0];
                    list.push(pair);
                    if (pair.indexOf('csrf_token=') === 0) csrf = pair.substring(11);
                }
            }
            return { cookie: list.join('; '), csrf: csrf };
        }

        function apiGet(req, path) {
            var resp = req.get(base + path);
            var status = req.getStatus();
            if (status != 200) throw 'GET ' + path + ' retornou HTTP ' + status;
            var data = JSON.parse(resp);
            if (!data.meta || data.meta.rc !== 'ok')
                throw 'GET ' + path + ' falhou: ' + (data.meta ? data.meta.msg : 'resposta inesperada');
            return data.data || [];
        }

        var req = new HttpRequest();
        req.addHeader('Content-Type: application/json');
        req.addHeader('Accept: application/json');
        var loginResp = req.post(base + '/api/login',
            JSON.stringify({ username: params.user, password: params.password, remember: false }));
        if (req.getStatus() != 200)
            throw 'Falha no login (HTTP ' + req.getStatus() + '): ' + String(loginResp).substring(0, 200);

        var session = getSession(req);
        if (session.cookie.indexOf('unifises=') === -1)
            throw 'Login sem cookie unifises (controladora nao e legada ou credencial invalida)';

        req.clearHeader();
        req.addHeader('Accept: application/json');
        req.addHeader('Content-Type: application/json');
        req.addHeader('Cookie: ' + session.cookie);
        if (session.csrf) req.addHeader('X-Csrf-Token: ' + session.csrf);

        var result = {
            devices: [],
            summary: { total: 0, connected: 0, disconnected: 0, upgradable: 0 },
            health: {},
            controller: {}
        };
        var s = encodeURIComponent(site);

        try {
            var raw = apiGet(req, '/api/s/' + s + '/stat/device');
            for (var i = 0; i < raw.length; i++) {
                var d = raw[i], ss = d['system-stats'] || {};
                var state = (d.state === undefined || d.state === null) ? 0 : d.state;
                var dev = {
                    mac: d.mac,
                    name: d.name || d.hostname || d.mac,
                    model: d.model || '',
                    type: d.type || '',
                    ip: d.ip || '',
                    version: d.version || '',
                    state: state,
                    upgradable: d.upgradable ? 1 : 0,
                    uptime: num(d.uptime),
                    clients: num(d.num_sta),
                    cpu: num(ss.cpu),
                    mem: num(ss.mem),
                    tx_bytes: num(d.tx_bytes),
                    rx_bytes: num(d.rx_bytes),
                    satisfaction: num(d.satisfaction),
                    temperature: num(d.general_temperature)
                };
                result.devices.push(dev);
                result.summary.total++;
                if (state == 1) result.summary.connected++; else result.summary.disconnected++;
                if (dev.upgradable) result.summary.upgradable++;
            }

            var codes = { ok: 1, warning: 2, error: 3 };
            var health = apiGet(req, '/api/s/' + s + '/stat/health');
            for (var j = 0; j < health.length; j++) {
                var h = health[j];
                result.health[h.subsystem] = {
                    status: codes[h.status] || 0,
                    users: num(h.num_user),
                    guests: num(h.num_guest),
                    adopted: num(h.num_adopted),
                    disconnected: num(h.num_disconnected),
                    pending: num(h.num_pending),
                    latency: num(h.latency),
                    xput_up: num(h.xput_up),
                    xput_down: num(h.xput_down)
                };
            }

            try {
                var sys = apiGet(req, '/api/s/' + s + '/stat/sysinfo');
                if (sys.length) {
                    result.controller.version = sys[0].version || '';
                    result.controller.update_available = sys[0].update_available ? 1 : 0;
                }
            } catch (e) { }
        }
        finally {
            try { req.post(base + '/api/logout', '{}'); } catch (e) { }
        }

        return JSON.stringify(result);
      description: Faz login na controladora legada (/api/login), coleta stat/device, stat/health e stat/sysinfo do site {$UNIFI.SITE} e faz logout. Todos os demais itens dependem deste.
      timeout: '{$UNIFI.TIMEOUT}'
      parameters:
      - name: url
        value: '{$UNIFI.URL}'
      - name: user
        value: '{$UNIFI.USER}'
      - name: password
        value: '{$UNIFI.PASSWORD}'
      - name: site
        value: '{$UNIFI.SITE}'
      tags:
      - tag: component
        value: raw
